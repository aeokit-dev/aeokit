{
  "name": "@aeokit/core",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis.ts",
    "./metrics": "./src/metrics.ts",
    "./providers": "./src/providers/index.ts",
    "./types": "./src/types.ts",
    "./public-report": "./src/public-report.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./analysis": {
        "types": "./dist/analysis.d.ts",
        "import": "./dist/analysis.js"
      },
      "./metrics": {
        "types": "./dist/metrics.d.ts",
        "import": "./dist/metrics.js"
      },
      "./providers": {
        "types": "./dist/providers/index.d.ts",
        "import": "./dist/providers/index.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      },
      "./public-report": {
        "types": "./dist/public-report.d.ts",
        "import": "./dist/public-report.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
