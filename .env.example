DATABASE_URL=postgres://openaeo:openaeo@localhost:5433/openaeo
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
# Local mode is login-free by default. For networked/self-hosted deployments,
# set api-key and provide comma-separated SHA-256 hashes of accepted keys.
AEOKIT_AUTH_MODE=none
AEOKIT_API_KEY_HASHES=
RUN_CADENCE_MINUTES=360
# Provider attempts include the first request. Interrupted runs resume until
# this limit is reached.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=2000
PROVIDER_TIMEOUT_MS=180000
RUN_STALE_AFTER_MS=600000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEALTH_STALE_MS=45000
STALE_RECOVERY_INTERVAL_MS=60000
# Set false to hide/redact upstream costs.
SHOW_PROVIDER_COSTS=true

# Optional PostHog source for observed AI referral traffic.
# POSTHOG_HOST is the app host for your region (for example,
# https://us.posthog.com or https://eu.posthog.com), not the SDK ingest host.
# The personal API key only needs Query Read access and stays server-side.
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Comma-separated exact event names that represent valuable outcomes, for
# example: demo requested,account created,purchase. Up to 10 events. Leave
# blank to report engagement while keeping conversion metrics unknown.
POSTHOG_SUCCESS_EVENTS=
# Legacy single-event settings are read when POSTHOG_SUCCESS_EVENTS is unset.
POSTHOG_SEARCH_EVENT=
POSTHOG_STOCK_ALERT_EVENT=

# Optional live and daily identified-crawler traffic source.
# Grant Zone > Zone > Read, Zone > Analytics > Read, and Account > Account
# Analytics > Read, scoped to the relevant Cloudflare account and zones.
CLOUDFLARE_API_TOKEN=

# Bright Data powers scraper-backed provider surfaces. Google AI Overview also
# requires the name of a SERP API zone.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_COUNTRY=US
BRIGHTDATA_LANGUAGE=en
BRIGHTDATA_MAX_CONCURRENT_RUNS=3

# OpenRouter powers AI Chat and remains available to existing prompt targets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar

# Optional local OpenAI-compatible AI Chat endpoint. From Docker Desktop, use
# host.docker.internal to reach a model server running on the Mac host.
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=local
AI_CHAT_MODEL=
AI_CHAT_WEB_SEARCH=false

# Optional native provider adapters.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Base64 value of DataForSEO login:API-password from the API Access page.
DATAFORSEO_API_KEY=
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_DEVICE=desktop
DATAFORSEO_OS=macos
# Used to localize Claude and Perplexity LLM Responses web search.
DATAFORSEO_COUNTRY_ISO_CODE=US
DATAFORSEO_CITY=
# Optional DataForSEO LLM Responses model overrides.
DATAFORSEO_CLAUDE_MODEL=claude-sonnet-4-0
DATAFORSEO_PERPLEXITY_MODEL=sonar
